<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #e8f5e9; -fx-font-family: 'Segoe UI', Arial;; -fx-font-size: 14px;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox>
            <MenuBar style="-fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                <Menu text="Archivo">
                    <MenuItem text="Nuevo Socio (Ctrl+N)" />
                    <MenuItem text="Guardar (Ctrl+S)" />
                </Menu>
                <Menu text="Editar" />
                <Menu text="Ayuda" />
            </MenuBar>
            <ToolBar style="-fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                <Button style="-fx-background-color: #e2e6ea; -fx-text-fill: #333333;" text="Nuevo"><tooltip><Tooltip text="Crear un nuevo socio" /></tooltip></Button>
                <Button style="-fx-font-weight: bold; -fx-background-color: #2e7d32; -fx-text-fill: white;" text="Guardar"><tooltip><Tooltip text="Guardar los cambios" /></tooltip></Button>
                <Button style="-fx-background-color: #ffcccc; -fx-text-fill: #cc0000;" text="Eliminar"><tooltip><Tooltip text="Eliminar socio seleccionado" /></tooltip></Button>
            </ToolBar>
        </VBox>
    </top>
    <left>
        <GridPane hgap="10" style="-fx-background-color: #e8f5e9; -fx-border-color: #e9ecef; -fx-border-width: 0 1 0 0;" vgap="15">
            <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

            <Label style="-fx-font-weight: bold;" text="Nombre:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField promptText="Ej: Laura" style="-fx-background-color: #f1f3f5; -fx-border-color: #ced4da; -fx-border-radius: 3; -fx-background-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label style="-fx-font-weight: bold;" text="Apellidos:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField promptText="Ej: Gómez Ruiz" style="-fx-background-color: #f1f3f5; -fx-border-color: #ced4da; -fx-border-radius: 3; -fx-background-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-font-weight: bold;" text="Fecha Nacimiento:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <DatePicker style="-fx-base: #f1f3f5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label style="-fx-font-weight: bold;" text="Provincia:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox promptText="Selecciona provincia..." style="-fx-background-color: #f1f3f5; -fx-border-color: #ced4da; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label style="-fx-font-weight: bold;" text="Cuota:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <VBox spacing="8" style="-fx-background-color: #e8f5e9;" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <RadioButton text="Básica" textFill="#555555">
               <toggleGroup>
                  <ToggleGroup fx:id="grupoCuota" />
               </toggleGroup></RadioButton>
                <RadioButton text="Plus" textFill="#555555" toggleGroup="$grupoCuota" />
                <RadioButton text="Premium" textFill="#555555" toggleGroup="$grupoCuota" />
                <RadioButton text="Joven" textFill="#555555" toggleGroup="$grupoCuota" />
            </VBox>

            <Label style="-fx-font-weight: bold;" text="Clase:" textFill="#333333" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <ComboBox promptText="Spinning, Yoga..." style="-fx-background-color: #f1f3f5; -fx-border-color: #ced4da; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <HBox alignment="CENTER_RIGHT" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="6">
                <padding><Insets top="20" /></padding>
                <Button style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-padding: 8 15;" text="Cancelar" />
                <Button style="-fx-background-color: #0056b3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Guardar Socio" />
            </HBox>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </left>
    <center>
        <VBox spacing="10" style="-fx-background-color: #e8f5e9;">
            <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Listado de Socios" textFill="#0056b3" />
            <TableView style="-fx-border-color: #e8f5e9;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn prefWidth="150" text="Nombre" />
                    <TableColumn prefWidth="200" text="Apellidos" />
                    <TableColumn prefWidth="100" text="Fecha Nac." />
                    <TableColumn prefWidth="100" text="Cuota" />
                </columns>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem text="Editar" />
                            <MenuItem text="Dar de baja" />
                            <MenuItem text="Renovar" />
                            <MenuItem text="Congelar" />
                            <MenuItem text="Historial" />
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #fff3cd; -fx-border-color: #ffeeba; -fx-border-width: 1 0 0 0;">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <Label style="-fx-font-weight: bold;" text="⚠ Revisa la fecha de nacimiento. Escríbela con el formato dd/mm/aaaa o usa el calendario." textFill="#856404" />
        </HBox>
    </bottom>
</BorderPane>
